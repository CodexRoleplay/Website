# En production, le site force https://www.codexroleplay.com (canonical, Open Graph, sitemap).
# Cette variable ne sert qu'en local si tu veux un autre domaine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TEBEX_PROJECT_ID=
TEBEX_PRIVATE_KEY=
TEBEX_PUBLIC_TOKEN=votre-token-public-headless
TEBEX_CATEGORY_ID=
TEBEX_PLUGIN_SECRET=

# Firebase (projet Codex)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Option 1 : fichier JSON à la racine (recommandé)
# Télécharge la clé depuis Firebase Console, enregistre-la sous :
# firebase-service-account.json
#
# Option 2 : chemin personnalisé
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
#
# Option 3 : JSON sur une ligne
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Option 4 : variables séparées
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative plus simple sur Vercel :
# FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
